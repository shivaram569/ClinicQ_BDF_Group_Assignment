  "item": [
    {
      "name": "1. Doctor CRUD Demo",
      "item": [
        {
          "name": "1.1 GET All Doctors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/doctors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns array of doctors', function () { var d = pm.response.json(); pm.expect(d.data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 POST Create Doctor (Dr. Gregory House)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Gregory House\",\n  \"specialization\": \"Diagnostic Medicine\",\n  \"phone\": \"+1-555-0999\"\n}"
            },
            "url": "{{base_url}}/doctors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var d = pm.response.json();",
                  "if (d.data && d.data.id) pm.environment.set('demo_doctor_id', d.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 GET Single Doctor by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/doctors/{{demo_doctor_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 PUT Update Doctor Specialization",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Gregory House, M.D.\",\n  \"specialization\": \"Infectious Diseases\",\n  \"phone\": \"+1-555-0998\"\n}"
            },
            "url": "{{base_url}}/doctors/{{demo_doctor_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 DELETE Doctor",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/doctors/{{demo_doctor_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
