    {
      "name": "4. MANDATORY SQL JOIN ENDPOINT (M.SHIVARAM KEY FEATURE)",
      "item": [
        {
          "name": "GET /bookings/details (Relational SQL JOIN with Doctor & Room)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bookings/details",
            "description": "Executes SQL INNER JOIN across bookings, doctors, and rooms.\nReturns doctor_name, doctor_specialization, room_number, room_floor, start_date, end_date, start_time, end_time, booking_status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contains doctor_name and room_number via SQL JOIN', function () {",
                  "    var d = pm.response.json();",
                  "    pm.expect(d.success).to.be.true;",
                  "    pm.expect(d.data.length).to.be.above(0);",
                  "    pm.expect(d.data[0]).to.have.property('doctor_name');",
                  "    pm.expect(d.data[0]).to.have.property('room_number');",
                  "    pm.expect(d.data[0]).to.have.property('start_date');",
                  "    pm.expect(d.data[0]).to.have.property('start_time');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
